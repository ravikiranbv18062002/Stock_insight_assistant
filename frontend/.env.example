# Used only by `npm run dev` (Vite's dev server proxy) — where to forward
# /api requests to while developing locally. NOT bundled into the built app;
# has no effect on `npm run build` or the Docker image.
VITE_DEV_BACKEND=http://localhost:8020

# For Docker / Kubernetes, the backend address is set at container startup
# via the BACKEND_URL environment variable instead (see Dockerfile / README) —
# not through a .env file, since it needs to be settable per-instance without
# rebuilding the image.
